{
	"name": "roundel",
	"version": "0.1.0",
	"description": "Practise chord progressions on a map of the twelve keys. No staff notation, anywhere.",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"keywords": [
		"music",
		"music-theory",
		"jazz",
		"piano",
		"ear-training",
		"web-midi",
		"spaced-repetition",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/bparticle/roundel.git"
	},
	"homepage": "https://github.com/bparticle/roundel#readme",
	"bugs": {
		"url": "https://github.com/bparticle/roundel/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --project server",
		"test:watch": "vitest --project server",
		"test:integration": "vitest run --project integration",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "vite-node scripts/seed.ts",
		"account:create": "vite-node scripts/account.ts",
		"db:up": "docker compose up -d db",
		"db:down": "docker compose down",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run format:check && npm run check && npm run test"
	},
	"dependencies": {
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"drizzle-orm": "^0.45.2",
		"nodemailer": "^9.0.5",
		"pg": "^8.22.0",
		"tone": "^15.1.22",
		"ts-fsrs": "^5.4.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.8"
	}
}
