# Postgres connection string.
#
# Production: your Neon *pooled* connection string — the one with `-pooler` in
# the hostname. Get it from the Neon console → Connection Details → Pooled.
#   postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/harmonic?sslmode=require
#
# Local development: `npm run db:up` starts the Postgres in docker-compose.yml.
DATABASE_URL="postgres://harmonic:harmonic@localhost:5432/harmonic"

# The single shared password that gates the app.
#
# The app is on a public URL with no accounts, so this is the only thing
# between the internet and your practice vault. Use something long.
APP_PASSWORD="change-me"

# Secret used to sign the session cookie. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET="change-me-too"
