# Postgres connection string.
#
# Local development: `npm run db:up` starts the Postgres in docker-compose.yml,
# which these defaults already point at.
#
# Anywhere else: any Postgres 15+ will do. Managed providers work well — a
# pooled connection string is preferred if yours offers one, because serverless
# platforms open a connection per request.
DATABASE_URL="postgres://harmonic:harmonic@localhost:5432/harmonic"

# Secret used to sign the session cookie. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET="change-me-too"

# Maileroo SMTP credentials, from your Maileroo dashboard. Used only to send
# password-reset links (self-service registration is not open, so this is the
# first thing in the app that needs an outside service at all).
SMTP_USERNAME="change-me"
SMTP_PW="change-me"

# The address reset emails come from. Must be on a domain verified in Maileroo.
MAIL_FROM="noreply@example.com"

# Where `npm run test:integration` connects. A disposable Postgres only —
# never point this at anything you'd mind losing. `npm run db:up`'s instance
# works; so does a throwaway branch from a provider that supports branching.
# src/lib/server/db/index.ts refuses to read DATABASE_URL at all while tests
# are running, so this is the only variable those tests will ever see.
TEST_DATABASE_URL="postgres://harmonic:harmonic@localhost:5432/harmonic"
